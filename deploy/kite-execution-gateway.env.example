# SERVER ONLY — never copy this file to the QUANT LAB desktop .env.
# The server process must be private, HTTPS-only, and run as a dedicated OS account.

KITE_API_KEY=
KITE_API_SECRET=
KITE_EXECUTION_DESKTOP_TOKEN=
KITE_EXECUTION_TOTP_SECRET=
KITE_EXECUTION_ACCOUNT_FINGERPRINT=
KITE_EXECUTION_ALLOWED_SYMBOLS=NSE:INFY,NSE:TCS
KITE_EXECUTION_MAX_NOTIONAL=25000
KITE_EXECUTION_REDIRECT_URL=https://kite-gateway.example.com/v1/kite/callback
KITE_EXECUTION_JOURNAL=/var/lib/nayak-kite-gateway/execution-gateway.sqlite

# Keep false while validating connectivity. Changing this to true enables only
# NSE/CNC/LIMIT/DAY requests that also pass exact-hash confirmation and TOTP.
KITE_EXECUTION_ENABLED=false
