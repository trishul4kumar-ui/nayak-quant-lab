# QUANT LAB environment — copy to .env. Never commit real credentials.

# --- Safety (all required for live; default is research-only) ---
LIVE_TRADING=false
LIVE_TRADING_ENABLED=false
BROKER_WRITE_ENABLED=false
BROKER_CONNECTED=false
RISK_ENGINE_HEALTHY=true
STRATEGY_APPROVED=false
MODEL_APPROVED=false
DATA_HEALTHY=true
SESSION_VALID=false

# --- Runtime ---
QUANT_LAB_ENV=research
QUANT_LAB_MODE=research
LOG_LEVEL=INFO
TZ=Asia/Kolkata
# QUANT_LAB_DATA_DIR=
# AI Quant Desk provider (research only; model is an explicit user configuration).
# QUANT_LAB_AGENT_MODEL=
# QUANT_LAB_AGENT_VISUALS=1

# --- Storage ---
POSTGRES_DSN=postgresql://quantlab:quantlab@localhost:5432/quantlab
DUCKDB_PATH=./data/research.duckdb
REDIS_URL=redis://localhost:6379/0
EXPERIMENT_LEDGER_PATH=./experiments/ledger.jsonl

# --- Brokers (unused until paper/live phases) ---
# OPENALGO_API_KEY=
# OPENALGO_HOST=http://127.0.0.1:5000
# KITE_API_KEY=
# KITE_API_SECRET= # legacy local Kite login only; never retain this on a desktop used for execution.
# KITE_ACCESS_TOKEN=
# Read-only real-time quote polling. List only explicit exchange:symbol identities.
# KITE_MARKET_DATA_SYMBOLS=NSE:INFY,NSE:TCS
#
# Manual Kite execution uses a separately deployed HTTPS gateway. The desktop receives
# only the limited client token below; KITE_API_SECRET remains on that gateway server.
# KITE_EXECUTION_GATEWAY_URL=https://kite-gateway.example.com
# KITE_EXECUTION_GATEWAY_CLIENT_TOKEN=

# --- AI (research assistants only; never authorize live orders) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
